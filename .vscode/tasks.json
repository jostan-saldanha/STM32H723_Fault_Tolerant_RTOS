{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build.ps1"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash Firmware (USB-C DFU)",
            "type": "process",
            "command": "C:\\Program Files\\STMicroelectronics\\STM32Cube\\STM32CubeProgrammer\\bin\\STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=usb1",
                "-w",
                "${workspaceFolder}/fault_tolerence/Debug/fault_tolerence.elf",
                "-v",
                "-s"
            ],
            "dependsOn": [
                "Build Firmware"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}